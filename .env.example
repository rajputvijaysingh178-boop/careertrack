# Local development defaults. Never put a real API key in this file.
DATABASE_URL=sqlite:///./careertrack.db
SECRET_KEY=replace-with-a-local-random-secret
ENABLE_SCHEDULER=false

# Optional Gemini enrichment. Obtain a key from Google AI Studio and set it
# only in your private local .env. The supported default model is below.
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash

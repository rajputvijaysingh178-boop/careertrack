# Copy to .env for local use, then replace every CHANGE_ME value locally.
# Never commit .env. Set this URL from the Neon project's pooled connection details.
APP_NAME=CareerTrack
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require

# Canonical JWT signing secret. The app also accepts legacy JWT_SECRET for compatibility.
SECRET_KEY=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# These values create the initial admin only when no admin already exists.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_STRONG_PASSWORD

# For a single-origin deployment (FastAPI also serves /tracker), same-origin requests need no CORS entry.
# For a split frontend, replace with its exact HTTPS origin(s), comma separated. Do not use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ENABLE_SCHEDULER=true
SEED_DEFAULT_SKILLS=true
AUTO_CREATE_SCHEMA=false

# Optional: Anthropic-backed AI enrichment; without a key, rule-based preparation still works.
LLM_API_KEY=
LLM_MODEL=

# Optional persistent writable storage for admin-uploaded study materials.
MATERIAL_UPLOAD_DIR=uploads/materials
MAX_MATERIAL_UPLOAD_BYTES=10485760
